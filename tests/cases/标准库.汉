# 标准库与语言特性综合演示（阶段六端到端样例）
# 覆盖：函数递归、如果/否则、当/对于循环、跳出/继续、文字/列表/字典/文件/时间

函数 斐波那契(序: 整数) -> 整数
  如果 序 < 2
    返回 序
  结束
  返回 斐波那契(序 - 1) + 斐波那契(序 - 2)
结束

函数 求和(上界: 整数) -> 整数
  变量 和 = 0
  对于 甲 = 1 到 上界
    和 = 和 + 甲
  结束
  返回 和
结束

函数 判断大小(甲: 整数, 乙: 整数) -> 文字
  如果 甲 > 乙
    返回 "甲大"
  结束
  否则
    返回 "乙大"
  结束
结束

打印 "== 标准库演示开始 =="
打印 斐波那契(10)
打印 求和(10)
打印 判断大小(5, 9)

# ---- 文字 ----
变量 句子 = "汉语言编译器"
打印 文字长度(句子)
打印 文字子串("abcdef", 1, 3)
如果 文字包含(句子, "编译")
  打印 "包含编译"
结束
否则
  打印 "不含编译"
结束
打印 文字转整数("42") + 1
打印 "结果：" + 转文字(55)
打印 转文字(3.5)

# ---- 小数运算 ----
变量 半径 = 2.5
打印 半径 * 半径 * 3.14

# ---- 列表 ----
变量 数列 = 列表创建()
列表新增(数列, 10)
列表新增(数列, 20)
列表新增(数列, 30)
打印 列表长度(数列)
打印 列表取整数(数列, 1)
列表设(数列, 1, 25)
打印 列表取整数(数列, 1)
列表删除(数列, 0)
打印 列表长度(数列)

# ---- 字典 ----
变量 表 = 字典创建()
字典设(表, "甲", 1)
字典设(表, "乙", 2)
打印 字典取整数(表, "甲")
如果 字典有(表, "乙")
  打印 "有乙"
结束
打印 字典长度(表)
字典删(表, "乙")
打印 字典长度(表)

# ---- 文件 ----
写文件("build/标准库临时.txt", "第一段")
