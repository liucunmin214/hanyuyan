# 缩进块与字符串插值（Python 风格格式）
# 端到端测试用例：编译后运行，输出须与 缩进与插值-期望.txt 完全一致

变量 名字 = "汉语言"
变量 版本 = 2

如果 版本 >= 2
    打印("{名字} {版本}.0 启用缩进块")
否则
    打印("仍是旧版")

变量 计数 = 0
当 计数 < 3
    计数 = 计数 + 1
    打印("第 {计数} 次")

对于 i = 1 到 3
    打印("值 {i} 平方 {i * i}")

变量 圆周率 = 3.14
变量 开 = 真
打印("圆周率 {圆周率}，真值 {开}，姓名 {名字}")
打印("转义 {{不插值}} 与 {{x}}")
打印("表达式 {1 + 2 * 3}")

# 旧式「结束」块仍然兼容
如果 版本 > 1
打印("旧式块也支持")
结束

打印("全部完成")
