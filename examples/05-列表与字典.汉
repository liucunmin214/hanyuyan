# 示例 05：列表与字典

# 列表：字面量与标准库操作
变量 水果 = ["苹果", "香蕉", "橘子"]
列表新增(水果, "西瓜")
打印 列表长度(水果)
打印 列表取文字(水果, 0)
打印 列表取文字(水果, 3)

列表设(水果, 1, "葡萄")
打印 列表取文字(水果, 1)

# 遍历列表（下标从 0 开始）
对于 下标 = 1 到 列表长度(水果)
  打印 列表取文字(水果, 下标 - 1)
结束

列表删除(水果, 0)
打印 列表长度(水果)

# 字典：字面量、成员访问糖与标准库操作
变量 人 = {名字: "小明", 年龄: 18}
打印 人.年龄          # 成员读 = 字典取(人, "年龄")
人.年龄 = 19          # 成员写 = 字典设(人, "年龄", 19)
打印 人.年龄
打印 字典取文字(人, "名字")

字典设(人, "城市", "北京")
打印 字典有(人, "城市")
打印 字典长度(人)

# 字典键列表
变量 键表 = 字典键(人)
打印 列表长度(键表)

字典删(人, "城市")
打印 字典长度(人)
