# 示例 10：缩进块与字符串插值
# Python 式缩进划块 + 字符串插值，旧的「结束」写法依然兼容

打印 "=== 缩进块 ==="

变量 名字 = "汉语言"
变量 版本 = 2

如果 版本 >= 2
    打印("{名字} {版本}.0：块用缩进划分，告别结束关键字")
否则
    打印("仍是旧版")

变量 计数 = 0
当 计数 < 3
    计数 = 计数 + 1
    打印("第 {计数} 次循环")

对于 i = 1 到 5
    如果 i % 2 == 0
        打印("{i} 是偶数")
    否则
        打印("{i} 是奇数")

# 函数体同样可以用缩进
函数 平方(n: 整数) -> 整数
    返回 n * n

打印("5 的平方是 {平方(5)}")

打印 "=== 字符串插值 ==="

变量 小数圆周率 = 3.14
变量 开 = 真
打印("小数 {小数圆周率}，布尔 {开}，姓名 {名字}")
打印("表达式：{1 + 2 * 3}，调用：{平方(6)}")
打印("字面大括号要写两遍：{{不是插值}}")

# 括号内可以自由折行，缩进不起作用
打印(1 + 2 +
     3)

# 旧式「结束」写法仍然兼容，两种形态可混用
如果 版本 > 1
打印("旧式块也支持")
结束

打印 "=== 完成 ==="
